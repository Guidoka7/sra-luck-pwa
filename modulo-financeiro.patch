+"use client";
+
+import { useMemo, useState } from "react";
+import Link from "next/link";
+import { Search, ArrowUpRight } from "lucide-react";
+import { useClientes, useContasReceber } from "@/features/financeiro/hooks";
+import { formatCurrency, formatCPF, formatDateBR, isOverdue } from "@/features/financeiro/utils";
+import { STATUS_PARCELA } from "@/features/financeiro/types";
+import { inputClass } from "@/features/financeiro/components/Modal";
+import { cn } from "@/lib/utils";
+
+const situacao = {
+  em_dia: { className: "bg-success/12 text-success border-success/25", label: "Em dia" },
+  com_pendencias: { className: "bg-gold/15 text-clay border-gold/30", label: "Com pendências" },
+  inadimplente: { className: "bg-alert/10 text-alert border-alert/25", label: "Inadimplente" },
+  quitado: { className: "bg-clay/10 text-clay/70 border-clay/20", label: "Quitado" },
+} as const;
+
+export default function ClientesPage() {
+  const { data: clientes, loading: lc } = useClientes();
+  const { data: parcelas, loading: lp } = useContasReceber();
+  const [q, setQ] = useState("");
+
+  const rows = useMemo(() => {
+    if (!clientes || !parcelas) return [];
+    return clientes.map((c) => {
+      const ps = parcelas.filter((p) => p.clienteId === c.id);
+      const totalContratado = ps.reduce((s, p) => s + p.valor, 0);
+      const totalRecebido = ps
+        .filter((p) => p.status === STATUS_PARCELA.recebido)
+        .reduce((s, p) => s + (p.valorRecebido ?? p.valor), 0);
+      const saldo = totalContratado - totalRecebido;
+      const pagas = ps.filter((p) => p.status === STATUS_PARCELA.recebido).length;
+      const pendentes = ps.filter(
+        (p) => p.status === STATUS_PARCELA.pendente || p.status === STATUS_PARCELA.aguardando,
+      ).length;
+      const atrasadas = ps.filter((p) => isOverdue(p) || p.status === STATUS_PARCELA.atrasado).length;
+      const ultimoPagamento =
+        ps
+          .filter((p) => p.recebidoEm)
+          .sort((a, b) => new Date(b.recebidoEm!).getTime() - new Date(a.recebidoEm!).getTime())[0]
+          ?.recebidoEm ?? null;
+      const proximoVencimento =
+        ps
+          .filter((p) => p.status !== STATUS_PARCELA.recebido && p.status !== STATUS_PARCELA.cancelado)
+          .sort((a, b) => new Date(a.vencimento).getTime() - new Date(b.vencimento).getTime())[0]
+          ?.vencimento ?? null;
+      let s: keyof typeof situacao = "em_dia";
+      if (atrasadas > 0) s = "inadimplente";
+      else if (pendentes > 0) s = "com_pendencias";
+      if (ps.length > 0 && pagas === ps.length) s = "quitado";
+      return {
+        ...c,
+        totalContratado,
+        totalRecebido,
+        saldo,
+        pagas,
+        pendentes,
+        atrasadas,
+        ultimoPagamento,
+        proximoVencimento,
+        situacao: s,
+      };
+    });
+  }, [clientes, parcelas]);
+
+  const filtered = rows.filter((r) => {
+    if (!q) return true;
+    const hay = `${r.nome} ${r.cpf} ${r.contrato}`.toLowerCase();
+    return hay.includes(q.toLowerCase());
+  });
+
+  return (
+    <div className="space-y-4">
+      <div className="rounded-3xl border border-rose/10 bg-white/70 p-4 shadow-card backdrop-blur-xl dark:border-white/8 dark:bg-white/4">
+        <div className="relative max-w-sm">
+          <Search className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-clay/45 dark:text-white/40" />
+          <input
+            placeholder="Buscar cliente ou CPF"
+            value={q}
+            onChange={(e) => setQ(e.target.value)}
+            className={inputClass + " pl-9"}
+            data-testid="clientes-search"
+          />
+        </div>
+      </div>
+
+      <div className="overflow-hidden rounded-3xl border border-rose/10 bg-white/80 shadow-card backdrop-blur-xl dark:border-white/8 dark:bg-white/4">
+        <div className="overflow-x-auto">
+          <table className="w-full min-w-[960px] border-collapse text-left">
+            <thead className="bg-blush/40 text-[10px] font-semibold uppercase tracking-[0.16em] text-burgundy/60 dark:bg-white/[0.05] dark:text-white/50">
+              <tr>
+                <th className="px-3 py-3">Cliente</th>
+                <th className="px-3 py-3 text-right">Contratado</th>
+                <th className="px-3 py-3 text-right">Recebido</th>
+                <th className="px-3 py-3 text-right">Saldo</th>
+                <th className="px-3 py-3 text-center">Pagas / Pend / Atr</th>
+                <th className="px-3 py-3">Último pgto</th>
+                <th className="px-3 py-3">Próx. venc.</th>
+                <th className="px-3 py-3">Situação</th>
+                <th className="w-[50px] px-3 py-3" />
+              </tr>
+            </thead>
+            <tbody className="divide-y divide-rose/8 text-sm text-clay dark:divide-white/6 dark:text-white/85">
+              {(lc || lp) && (
+                <tr>
+                  <td colSpan={9} className="py-8 text-center text-clay/55 dark:text-white/45">
+                    Carregando…
+                  </td>
+                </tr>
+              )}
+              {filtered.map((r) => {
+                const s = situacao[r.situacao];
+                return (
+                  <tr key={r.id} className="transition-colors hover:bg-blush/25 dark:hover:bg-white/[0.03]">
+                    <td className="px-3 py-3">
+                      <div className="font-semibold text-burgundy dark:text-[#f0d9d4]">{r.nome}</div>
+                      <div className="text-[10px] uppercase tracking-[0.14em] text-clay/55 dark:text-white/45">
+                        {formatCPF(r.cpf)} · {r.contrato}
+                      </div>
+                    </td>
+                    <td className="px-3 py-3 text-right tabular-nums">{formatCurrency(r.totalContratado)}</td>
+                    <td className="px-3 py-3 text-right tabular-nums text-success">{formatCurrency(r.totalRecebido)}</td>
+                    <td className="px-3 py-3 text-right font-semibold tabular-nums">{formatCurrency(r.saldo)}</td>
+                    <td className="px-3 py-3 text-center text-xs">
+                      <span className="text-success">{r.pagas}</span> · <span className="text-clay">{r.pendentes}</span> ·{" "}
+                      <span className="text-alert">{r.atrasadas}</span>
+                    </td>
+                    <td className="px-3 py-3 tabular-nums">{r.ultimoPagamento ? formatDateBR(r.ultimoPagamento) : "—"}</td>
+                    <td className="px-3 py-3 tabular-nums">
+                      {r.proximoVencimento ? formatDateBR(r.proximoVencimento) : "—"}
+                    </td>
+                    <td className="px-3 py-3">
+                      <span
+                        className={cn(
+                          "inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.1em]",
+                          s.className,
+                        )}
+                      >
+                        {s.label}
+                      </span>
+                    </td>
+                    <td className="px-3 py-3">
+                      <Link
+                        href={`/admin/financeiro/clientes/${r.id}`}
+                        className="inline-flex items-center gap-1 text-burgundy/70 hover:text-burgundy dark:text-[#d5c8c6]/70 dark:hover:text-[#f0d9d4]"
+                        data-testid={`cliente-open-${r.id}`}
+                      >
+                        <ArrowUpRight className="h-4 w-4" />
+                      </Link>
+                    </td>
+                  </tr>
+                );
+              })}
+            </tbody>
+          </table>
+        </div>
+      </div>
+    </div>
+  );
+}
