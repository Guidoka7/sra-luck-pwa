+"use client";
+
+import { Plug, RefreshCw, Building2, CreditCard, Landmark, ShieldAlert, LucideIcon } from "lucide-react";
+import { toast } from "sonner";
+import { Button } from "@/components/ui/Button";
+import { useIntegracoes, useSincronizacao } from "@/features/financeiro/hooks";
+import { IntegracaoStatusBadge } from "@/features/financeiro/components/badges";
+import { formatDateTimeBR } from "@/features/financeiro/utils";
+
+const ICON: Record<string, LucideIcon> = {
+  conta_azul: Building2,
+  mercado_pago: CreditCard,
+  banco: Landmark,
+};
+
+export default function IntegracoesPage() {
+  const { data: integracoes, loading } = useIntegracoes();
+  const { data: sinc } = useSincronizacao();
+
+  return (
+    <div className="space-y-5">
+      <div className="grid grid-cols-1 gap-4 md:grid-cols-3">
+        {loading && <div className="text-sm text-clay/60 dark:text-white/50">Carregando integrações…</div>}
+        {(integracoes || []).map((i) => {
+          const Icon = ICON[i.id] || Plug;
+          return (
+            <div
+              key={i.id}
+              className="rounded-3xl border border-rose/10 bg-white/70 p-5 shadow-card backdrop-blur-xl dark:border-white/8 dark:bg-white/4"
+            >
+              <div className="flex items-start justify-between">
+                <div className="grid h-10 w-10 place-items-center rounded-xl bg-blush/60 text-burgundy dark:bg-white/6 dark:text-[#d9a5a3]">
+                  <Icon className="h-5 w-5" />
+                </div>
+                <IntegracaoStatusBadge status={i.status} />
+              </div>
+              <h3 className="mt-3 text-base font-semibold text-burgundy dark:text-[#f0d9d4]">{i.nome}</h3>
+              <p className="mt-1 text-xs text-clay/70 dark:text-white/55">{i.descricao}</p>
+              <Button
+                size="sm"
+                variant="secondary"
+                className="mt-4 w-full"
+                onClick={() =>
+                  toast.info("Integração ainda não conectada", {
+                    description: "Configuração real será feita quando a API estiver disponível.",
+                  })
+                }
+                data-testid={`btn-integrar-${i.id}`}
+              >
+                Configurar
+              </Button>
+            </div>
+          );
+        })}
+      </div>
+
+      <div className="flex items-start gap-3 rounded-3xl border border-gold/25 bg-gold/12 p-4 text-sm text-clay dark:border-gold/30 dark:bg-gold/15 dark:text-[#f5dcbf]">
+        <ShieldAlert className="mt-0.5 h-4 w-4 shrink-0" />
+        <span>
+          Nenhuma integração externa está conectada nesta etapa. Todos os status refletem estritamente o estado real:
+          em preparação, planejado ou em desenvolvimento.
+        </span>
+      </div>
+
+      <div className="rounded-3xl border border-rose/10 bg-white/70 p-5 shadow-card backdrop-blur-xl dark:border-white/8 dark:bg-white/4">
+        <div className="mb-4 flex items-center justify-between">
+          <div>
+            <h3 className="text-sm font-semibold text-burgundy dark:text-[#f0d9d4]">Central de sincronização</h3>
+            <p className="text-[11px] text-clay/60 dark:text-white/50">
+              Última sincronização: {sinc?.ultima ? formatDateTimeBR(sinc.ultima) : "nunca"}
+            </p>
+          </div>
+          <Button
+            size="sm"
+            variant="secondary"
+            onClick={() =>
+              toast.info("Sincronização indisponível", {
+                description: "Aguardando conexão com Conta Azul.",
+              })
+            }
+            data-testid="btn-sincronizar"
+          >
+            <RefreshCw className="h-3.5 w-3.5" /> Sincronizar agora
+          </Button>
+        </div>
+        <div className="grid grid-cols-2 gap-3 md:grid-cols-5">
+          <SyncStat label="Clientes" value={sinc?.clientesSincronizados ?? 0} />
+          <SyncStat label="Parcelas" value={sinc?.parcelasSincronizadas ?? 0} />
+          <SyncStat label="Recebimentos" value={sinc?.recebimentosSincronizados ?? 0} />
+          <SyncStat label="Pendências" value={sinc?.pendencias ?? 0} accent="gold" />
+          <SyncStat label="Erros" value={sinc?.erros ?? 0} accent="alert" />
+        </div>
+      </div>
+    </div>
+  );
+}
+
+function SyncStat({
+  label,
+  value,
+  accent,
+}: {
+  label: string;
+  value: number;
+  accent?: "gold" | "alert";
+}) {
+  const color = accent === "gold" ? "text-clay" : accent === "alert" ? "text-alert" : "text-burgundy dark:text-[#f0d9d4]";
+  return (
+    <div className="rounded-2xl border border-rose/10 p-3 dark:border-white/8">
+      <div className="text-[10px] font-semibold uppercase tracking-[0.14em] text-clay/55 dark:text-white/45">{label}</div>
+      <div className={`mt-1 text-xl font-semibold tabular-nums ${color}`}>{value}</div>
+    </div>
+  );
+}
