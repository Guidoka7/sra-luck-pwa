@@ -0,0 +1,259 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { toast } from "sonner";
+import { Button } from "@/components/ui/Button";
+import { Modal, Field, inputClass, selectClass } from "./Modal";
+import { contasReceberService } from "../services";
+import { FORMA_LABEL, FORMA_PAGAMENTO, ORIGEM, ORIGEM_LABEL, Parcela, FormaPagamento, Origem } from "../types";
+import { formatCurrency } from "../utils";
+
+interface DialogProps {
+  parcela: Parcela | null;
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+}
+
+export function RegistrarRecebimentoDialog({ parcela, open, onOpenChange }: DialogProps) {
+  const [valor, setValor] = useState<string>("");
+  const [data, setData] = useState<string>(new Date().toISOString().slice(0, 10));
+  const [forma, setForma] = useState<FormaPagamento>(FORMA_PAGAMENTO.pix);
+  const [origem, setOrigem] = useState<Origem>(ORIGEM.manual);
+  const [obs, setObs] = useState<string>("");
+  const [saving, setSaving] = useState(false);
+
+  useEffect(() => {
+    if (parcela) {
+      setValor(String(parcela.valor));
+      setForma(parcela.formaPagamento);
+      setOrigem(parcela.origem);
+      setObs("");
+      setData(new Date().toISOString().slice(0, 10));
+    }
+  }, [parcela]);
+
+  const submit = async () => {
+    if (!parcela) return;
+    setSaving(true);
+    try {
+      await contasReceberService.registrarRecebimento(parcela.id, {
+        valor: Number(valor),
+        data: new Date(data).toISOString(),
+        formaPagamento: forma,
+        origem,
+        observacoes: obs,
+      });
+      toast.success("Recebimento registrado", {
+        description: `Parcela ${parcela.numero}/${parcela.totalParcelas} de ${parcela.clienteNome} marcada como recebida.`,
+      });
+      onOpenChange(false);
+    } catch {
+      toast.error("Erro ao registrar recebimento");
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  return (
+    <Modal
+      open={open}
+      onClose={() => onOpenChange(false)}
+      title="Registrar recebimento"
+      description={parcela ? `Parcela ${parcela.numero}/${parcela.totalParcelas} — ${parcela.clienteNome}` : ""}
+      footer={
+        <>
+          <Button variant="ghost" size="sm" onClick={() => onOpenChange(false)}>Cancelar</Button>
+          <Button size="sm" onClick={submit} loading={saving} data-testid="btn-confirmar-recebimento">
+            Confirmar
+          </Button>
+        </>
+      }
+    >
+      <div className="grid grid-cols-2 gap-3">
+        <Field label="Valor recebido">
+          <input
+            type="number"
+            step="0.01"
+            className={inputClass}
+            value={valor}
+            onChange={(e) => setValor(e.target.value)}
+            data-testid="input-valor-recebido"
+          />
+          <p className="mt-1 text-[10px] text-clay/50 dark:text-white/40">
+            Original: {parcela ? formatCurrency(parcela.valor) : "—"}
+          </p>
+        </Field>
+        <Field label="Data">
+          <input type="date" className={inputClass} value={data} onChange={(e) => setData(e.target.value)} />
+        </Field>
+        <Field label="Forma de pagamento">
+          <select
+            className={selectClass}
+            value={forma}
+            onChange={(e) => setForma(e.target.value as FormaPagamento)}
+            data-testid="select-forma-pagamento"
+          >
+            {Object.entries(FORMA_LABEL).map(([k, v]) => (
+              <option key={k} value={k}>{v}</option>
+            ))}
+          </select>
+        </Field>
+        <Field label="Origem">
+          <select className={selectClass} value={origem} onChange={(e) => setOrigem(e.target.value as Origem)}>
+            {Object.entries(ORIGEM_LABEL).map(([k, v]) => (
+              <option key={k} value={k}>{v}</option>
+            ))}
+          </select>
+        </Field>
+        <Field label="Observações" span={2}>
+          <textarea rows={3} className={inputClass} value={obs} onChange={(e) => setObs(e.target.value)} />
+        </Field>
+      </div>
+    </Modal>
+  );
+}
+
+export function NegociarDialog({ parcela, open, onOpenChange }: DialogProps) {
+  const [novoVencimento, setNovoVencimento] = useState("");
+  const [obs, setObs] = useState("");
+  const [saving, setSaving] = useState(false);
+
+  useEffect(() => {
+    if (parcela) {
+      setNovoVencimento(new Date(parcela.vencimento).toISOString().slice(0, 10));
+      setObs("");
+    }
+  }, [parcela]);
+
+  const submit = async () => {
+    if (!parcela) return;
+    setSaving(true);
+    try {
+      await contasReceberService.negociar(parcela.id, {
+        novoVencimento: new Date(novoVencimento).toISOString(),
+        observacoes: obs,
+      });
+      toast.success("Negociação registrada");
+      onOpenChange(false);
+    } catch {
+      toast.error("Erro ao negociar");
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  return (
+    <Modal
+      open={open}
+      onClose={() => onOpenChange(false)}
+      title="Negociar parcela"
+      description="Ajuste o vencimento e registre observações."
+      footer={
+        <>
+          <Button variant="ghost" size="sm" onClick={() => onOpenChange(false)}>Voltar</Button>
+          <Button size="sm" onClick={submit} loading={saving}>Confirmar</Button>
+        </>
+      }
+    >
+      <div className="space-y-3">
+        <Field label="Novo vencimento">
+          <input type="date" className={inputClass} value={novoVencimento} onChange={(e) => setNovoVencimento(e.target.value)} />
+        </Field>
+        <Field label="Observações">
+          <textarea rows={3} className={inputClass} value={obs} onChange={(e) => setObs(e.target.value)} />
+        </Field>
+      </div>
+    </Modal>
+  );
+}
+
+export function CancelarDialog({ parcela, open, onOpenChange }: DialogProps) {
