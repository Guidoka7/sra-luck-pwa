diff --git a/src/features/financeiro/components/Modal.tsx b/src/features/financeiro/components/Modal.tsx
new file mode 100644
index 0000000..19127b0
--- /dev/null
+++ b/src/features/financeiro/components/Modal.tsx
@@ -0,0 +1,148 @@
+"use client";
+
+import { AnimatePresence, motion } from "framer-motion";
+import { X } from "lucide-react";
+import { ReactNode, useEffect } from "react";
+
+// Modal centralizado leve (sem Radix) — compatível com o design system Sra. Luck.
+export function Modal({
+  open,
+  onClose,
+  title,
+  description,
+  children,
+  footer,
+  size = "md",
+}: {
+  open: boolean;
+  onClose: () => void;
+  title: string;
+  description?: string;
+  children: ReactNode;
+  footer?: ReactNode;
+  size?: "sm" | "md" | "lg";
+}) {
+  useEffect(() => {
+    if (!open) return;
+    const onKey = (e: KeyboardEvent) => e.key === "Escape" && onClose();
+    document.addEventListener("keydown", onKey);
+    return () => document.removeEventListener("keydown", onKey);
+  }, [open, onClose]);
+
+  const widthClass = size === "sm" ? "max-w-sm" : size === "lg" ? "max-w-2xl" : "max-w-lg";
+
+  return (
+    <AnimatePresence>
+      {open && (
+        <motion.div
+          initial={{ opacity: 0 }}
+          animate={{ opacity: 1 }}
+          exit={{ opacity: 0 }}
+          className="fixed inset-0 z-[70] flex items-center justify-center bg-burgundy-dark/28 backdrop-blur-sm px-4 dark:bg-black/60"
+          onClick={onClose}
+        >
+          <motion.div
+            initial={{ opacity: 0, y: 12, scale: 0.98 }}
+            animate={{ opacity: 1, y: 0, scale: 1 }}
+            exit={{ opacity: 0, y: 8, scale: 0.98 }}
+            transition={{ duration: 0.18, ease: [0.22, 1, 0.36, 1] }}
+            className={`w-full ${widthClass} rounded-3xl border border-rose/12 bg-white/95 p-6 shadow-soft backdrop-blur-2xl dark:border-white/8 dark:bg-[#161318]/96`}
+            onClick={(e) => e.stopPropagation()}
+          >
+            <div className="mb-4 flex items-start justify-between gap-4">
+              <div>
+                <h3 className="text-base font-semibold tracking-[-0.01em] text-burgundy dark:text-[#f0d9d4]">
+                  {title}
+                </h3>
+                {description && (
+                  <p className="mt-1 text-xs text-clay/70 dark:text-white/55">{description}</p>
+                )}
+              </div>
+              <button
+                onClick={onClose}
+                aria-label="Fechar"
+                className="rounded-lg p-1.5 text-clay/50 hover:bg-blush/60 hover:text-burgundy dark:text-white/45 dark:hover:bg-white/6"
+              >
+                <X className="h-4 w-4" />
+              </button>
+            </div>
+            <div className="space-y-3">{children}</div>
+            {footer && (
+              <div className="mt-5 flex items-center justify-end gap-2 border-t border-rose/8 pt-4 dark:border-white/6">
+                {footer}
+              </div>
+            )}
+          </motion.div>
+        </motion.div>
+      )}
+    </AnimatePresence>
+  );
+}
+
+// Drawer lateral (side sheet)
+export function Drawer({
+  open,
+  onClose,
+  children,
+}: {
+  open: boolean;
+  onClose: () => void;
+  children: ReactNode;
+}) {
+  useEffect(() => {
+    if (!open) return;
+    const onKey = (e: KeyboardEvent) => e.key === "Escape" && onClose();
+    document.addEventListener("keydown", onKey);
+    return () => document.removeEventListener("keydown", onKey);
+  }, [open, onClose]);
+
+  return (
+    <AnimatePresence>
+      {open && (
+        <motion.div
+          initial={{ opacity: 0 }}
+          animate={{ opacity: 1 }}
+          exit={{ opacity: 0 }}
+          className="fixed inset-0 z-[65] bg-burgundy-dark/28 backdrop-blur-sm dark:bg-black/60"
+          onClick={onClose}
+        >
+          <motion.aside
+            initial={{ x: "100%" }}
+            animate={{ x: 0 }}
+            exit={{ x: "100%" }}
+            transition={{ duration: 0.24, ease: [0.22, 1, 0.36, 1] }}
+            className="absolute right-0 top-0 h-full w-full max-w-2xl overflow-y-auto border-l border-rose/12 bg-white/98 shadow-soft dark:border-white/8 dark:bg-[#141216]"
+            onClick={(e) => e.stopPropagation()}
+          >
+            {children}
+          </motion.aside>
+        </motion.div>
+      )}
+    </AnimatePresence>
+  );
+}
+
+// Campos de formulário simples reutilizáveis
+export function Field({
+  label,
+  children,
+  span = 1,
+}: {
+  label: string;
+  children: ReactNode;
+  span?: 1 | 2;
+}) {
+  return (
+    <div className={span === 2 ? "col-span-2" : "col-span-1"}>
+      <label className="mb-1 block text-[10px] font-semibold uppercase tracking-[0.14em] text-clay/60 dark:text-white/50">
+        {label}
+      </label>
+      {children}
+    </div>
+  );
+}
+
+export const inputClass =
+  "w-full rounded-xl border border-rose/15 bg-white/70 px-3 py-2 text-sm text-clay outline-none placeholder:text-clay/40 focus:border-burgundy/40 focus:bg-white dark:border-white/10 dark:bg-white/5 dark:text-white/85 dark:placeholder:text-white/30 dark:focus:border-white/25";
+
+export const selectClass = inputClass + " appearance-none pr-8";
