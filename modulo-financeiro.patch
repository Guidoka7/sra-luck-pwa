+        </div>
+        <div className="inline-flex items-center gap-2 text-xs text-clay/70 dark:text-white/55">
+          <ArrowDownToLine className="h-4 w-4 text-success" />
+          Total: <span className="font-semibold tabular-nums text-burgundy dark:text-[#f0d9d4]">{formatCurrency(total)}</span>
+        </div>
+      </div>
+
+      <div className="overflow-hidden rounded-3xl border border-rose/10 bg-white/80 shadow-card backdrop-blur-xl dark:border-white/8 dark:bg-white/4">
+        <div className="overflow-x-auto">
+          <table className="w-full border-collapse text-left">
+            <thead className="bg-blush/40 text-[10px] font-semibold uppercase tracking-[0.16em] text-burgundy/60 dark:bg-white/[0.05] dark:text-white/50">
+              <tr>
+                <th className="px-3 py-3">Data</th>
+                <th className="px-3 py-3">Cliente</th>
+                <th className="px-3 py-3">Descrição</th>
+                <th className="px-3 py-3 text-right">Valor</th>
+                <th className="px-3 py-3">Forma</th>
+                <th className="px-3 py-3">Origem</th>
+              </tr>
+            </thead>
+            <tbody className="divide-y divide-rose/8 text-sm text-clay dark:divide-white/6 dark:text-white/85">
+              {loading && (
+                <tr><td colSpan={6} className="py-8 text-center text-clay/55 dark:text-white/45">Carregando…</td></tr>
+              )}
+              {!loading && filtered.length === 0 && (
+                <tr><td colSpan={6} className="py-8 text-center text-clay/55 dark:text-white/45">Nenhum recebimento.</td></tr>
+              )}
+              {filtered.map((r) => (
+                <tr key={r.id}>
+                  <td className="px-3 py-3 tabular-nums">{formatDateBR(r.data)}</td>
+                  <td className="px-3 py-3 font-semibold text-burgundy dark:text-[#f0d9d4]">{r.clienteNome}</td>
+                  <td className="px-3 py-3 text-clay/80 dark:text-white/70">{r.descricao}</td>
+                  <td className="px-3 py-3 text-right font-semibold tabular-nums text-success">{formatCurrency(r.valor)}</td>
+                  <td className="px-3 py-3"><FormaPagamentoBadge forma={r.formaPagamento} /></td>
+                  <td className="px-3 py-3"><OrigemBadge origem={r.origem} /></td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      </div>
+    </div>
+  );
+}
