+"use client";
+
+import { useMemo, useState } from "react";
+import {
+  Search,
+  UserPlus,
+  Receipt,
+  Edit,
+  ArrowDownToLine,
+  ClipboardCheck,
+  XCircle,
+  RefreshCw,
+  Plug,
+  Radio,
+  RefreshCcw,
+  Paperclip,
+  Percent,
+  LucideIcon,
+} from "lucide-react";
+import { useHistorico } from "@/features/financeiro/hooks";
+import { formatDateTimeBR } from "@/features/financeiro/utils";
+import { HISTORICO_TIPOS, HistoricoTipo } from "@/features/financeiro/types";
+import { inputClass } from "@/features/financeiro/components/Modal";
+
+const TIPO_META: Record<HistoricoTipo, { icon: LucideIcon; label: string; color: string }> = {
+  [HISTORICO_TIPOS.cliente_criado]: { icon: UserPlus, label: "Cliente criado", color: "text-burgundy" },
+  [HISTORICO_TIPOS.parcela_criada]: { icon: Receipt, label: "Parcela criada", color: "text-clay" },
+  [HISTORICO_TIPOS.parcela_alterada]: { icon: Edit, label: "Parcela alterada", color: "text-clay" },
+  [HISTORICO_TIPOS.recebimento]: { icon: ArrowDownToLine, label: "Recebimento", color: "text-success" },
+  [HISTORICO_TIPOS.baixa]: { icon: ClipboardCheck, label: "Baixa", color: "text-success" },
+  [HISTORICO_TIPOS.cancelamento]: { icon: XCircle, label: "Cancelamento", color: "text-alert" },
+  [HISTORICO_TIPOS.negociacao]: { icon: RefreshCw, label: "Negociação", color: "text-burgundy" },
+  [HISTORICO_TIPOS.integracao]: { icon: Plug, label: "Integração", color: "text-clay" },
+  [HISTORICO_TIPOS.webhook]: { icon: Radio, label: "Webhook", color: "text-clay" },
+  [HISTORICO_TIPOS.sincronizacao]: { icon: RefreshCcw, label: "Sincronização", color: "text-clay" },
+  [HISTORICO_TIPOS.comprovante]: { icon: Paperclip, label: "Comprovante", color: "text-clay" },
+  [HISTORICO_TIPOS.comissao]: { icon: Percent, label: "Comissão", color: "text-burgundy" },
+};
+
+export default function HistoricoPage() {
+  const { data, loading } = useHistorico();
+  const [q, setQ] = useState("");
+
+  const filtered = useMemo(
+    () => (data || []).filter((h) => !q || h.descricao.toLowerCase().includes(q.toLowerCase())),
+    [data, q],
+  );
+
+  return (
+    <div className="space-y-4">
+      <div className="rounded-3xl border border-rose/10 bg-white/70 p-4 shadow-card backdrop-blur-xl dark:border-white/8 dark:bg-white/4">
+        <div className="relative max-w-sm">
+          <Search className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-clay/45 dark:text-white/40" />
+          <input
+            placeholder="Buscar no histórico"
+            value={q}
+            onChange={(e) => setQ(e.target.value)}
+            className={inputClass + " pl-9"}
+          />
+        </div>
+      </div>
+
+      <div className="rounded-3xl border border-rose/10 bg-white/80 shadow-card backdrop-blur-xl dark:border-white/8 dark:bg-white/4">
