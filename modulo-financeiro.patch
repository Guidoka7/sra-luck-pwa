+        )}
+        <ul className="divide-y divide-rose/8 dark:divide-white/6">
+          {filtered.map((h) => {
+            const meta = TIPO_META[h.tipo] ?? {
+              icon: Receipt,
+              label: h.tipo,
+              color: "text-clay",
