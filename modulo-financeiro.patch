+      <div className="rounded-3xl border border-rose/10 bg-white/70 p-6 shadow-card backdrop-blur-xl dark:border-white/8 dark:bg-white/4">
+        <div className="flex flex-wrap items-start justify-between gap-4">
+          <div>
+            <p className="text-[10px] font-semibold uppercase tracking-[0.18em] text-clay/55 dark:text-white/45">
+              {cliente.contrato}
+            </p>
+            <h2 className="mt-1 text-2xl font-semibold tracking-[-0.02em] text-burgundy dark:text-[#f0d9d4]">
+              {cliente.nome}
+            </h2>
+            <p className="mt-1 text-sm text-clay/70 dark:text-white/55">{formatCPF(cliente.cpf)}</p>
+            <div className="mt-3 flex flex-wrap gap-4 text-xs text-clay/70 dark:text-white/55">
+              <span className="inline-flex items-center gap-1.5">
+                <Mail className="h-3.5 w-3.5" />
+                {cliente.email}
+              </span>
+              <span className="inline-flex items-center gap-1.5">
+                <Phone className="h-3.5 w-3.5" />
+                {formatPhoneBR(cliente.telefone)}
+              </span>
+            </div>
+          </div>
+          <div className="grid grid-cols-3 gap-6 text-right">
+            <div>
+              <div className="text-[10px] font-semibold uppercase tracking-[0.14em] text-clay/55 dark:text-white/45">
+                Contratado
+              </div>
+              <div className="text-lg font-semibold tabular-nums text-burgundy dark:text-[#f0d9d4]">
+                {formatCurrency(totalContratado)}
+              </div>
+            </div>
+            <div>
+              <div className="text-[10px] font-semibold uppercase tracking-[0.14em] text-clay/55 dark:text-white/45">
+                Recebido
+              </div>
+              <div className="text-lg font-semibold tabular-nums text-success">
+                {formatCurrency(totalRecebido)}
+              </div>
+            </div>
+            <div>
+              <div className="text-[10px] font-semibold uppercase tracking-[0.14em] text-clay/55 dark:text-white/45">
+                Saldo aberto
+              </div>
+              <div className="text-lg font-semibold tabular-nums text-burgundy dark:text-[#f0d9d4]">
+                {formatCurrency(saldoPendente)}
+              </div>
+            </div>
+          </div>
+        </div>
+      </div>
+
+      <div className="flex gap-1 overflow-x-auto">
+        {SUBTABS.map((k) => (
+          <button
+            key={k}
+            onClick={() => setTab(k)}
+            className={cn(
+              "rounded-xl px-3 py-2 text-xs font-semibold transition-colors",
+              tab === k
+                ? "bg-burgundy text-pearl dark:bg-[#7f3546] dark:text-[#fff7f4]"
+                : "text-clay/60 hover:bg-blush/60 hover:text-burgundy dark:text-white/50 dark:hover:bg-white/6",
+            )}
+          >
+            {LABEL[k]}
+            {k === "parcelas" && ` (${parcelas.length})`}
+          </button>
+        ))}
+      </div>
+
+      {tab === "parcelas" && (
+        <div className="overflow-hidden rounded-3xl border border-rose/10 bg-white/80 shadow-card backdrop-blur-xl dark:border-white/8 dark:bg-white/4">
+          <div className="overflow-x-auto">
+            <table className="w-full border-collapse text-left">
+              <thead className="bg-blush/40 text-[10px] font-semibold uppercase tracking-[0.16em] text-burgundy/60 dark:bg-white/[0.05] dark:text-white/50">
+                <tr>
+                  <th className="px-3 py-3 text-center">#</th>
