@@ -0,0 +1,266 @@
+"use client";
+
+import { useMemo, useState } from "react";
+import { Search, Download, Filter, MoreHorizontal } from "lucide-react";
+import { useContasReceber } from "@/features/financeiro/hooks";
+import {
+  formatCurrency,
+  formatDateBR,
+  formatCPF,
+} from "@/features/financeiro/utils";
+import {
+  FORMA_LABEL,
+  ORIGEM_LABEL,
+  STATUS_LABEL,
+  STATUS_PARCELA,
+  Parcela,
+  StatusParcela,
+} from "@/features/financeiro/types";
+import { StatusBadge, FormaPagamentoBadge, OrigemBadge } from "@/features/financeiro/components/badges";
+import ParcelaDetailDrawer from "@/features/financeiro/components/ParcelaDetailDrawer";
+import { inputClass, selectClass } from "@/features/financeiro/components/Modal";
+
+const PERIODOS = {
+  todos: "Todos os períodos",
+  hoje: "Hoje",
+  semana: "Próximos 7 dias",
+  mes: "Este mês",
+  atrasadas: "Em atraso",
+};
+
+export default function ContasReceberPage() {
+  const { data, loading } = useContasReceber();
+  const [q, setQ] = useState("");
+  const [statusFiltro, setStatusFiltro] = useState<string>("todos");
+  const [periodo, setPeriodo] = useState<string>("todos");
+  const [forma, setForma] = useState<string>("todos");
+  const [origem, setOrigem] = useState<string>("todos");
+  const [selected, setSelected] = useState<Parcela | null>(null);
+  const [drawerOpen, setDrawerOpen] = useState(false);
+
+  const filtered = useMemo<Parcela[]>(() => {
+    if (!data) return [];
+    const now = new Date();
+    return data.filter((p) => {
+      if (q) {
+        const query = q.toLowerCase();
+        const hay = [
+          p.clienteNome,
+          p.clienteCpf,
+          p.clienteContrato,
+          `${p.numero}/${p.totalParcelas}`,
+        ]
+          .join(" ")
+          .toLowerCase();
+        if (!hay.includes(query)) return false;
+      }
+      if (statusFiltro !== "todos" && p.status !== statusFiltro) return false;
+      if (forma !== "todos" && p.formaPagamento !== forma) return false;
+      if (origem !== "todos" && p.origem !== origem) return false;
+      const venc = new Date(p.vencimento);
+      if (periodo === "hoje" && venc.toDateString() !== now.toDateString()) return false;
+      if (periodo === "semana") {
+        const diff = (venc.getTime() - now.getTime()) / 86400000;
+        if (diff < 0 || diff > 7) return false;
+      }
+      if (
+        periodo === "mes" &&
+        (venc.getMonth() !== now.getMonth() || venc.getFullYear() !== now.getFullYear())
+      )
+        return false;
+      if (periodo === "atrasadas" && p.status !== STATUS_PARCELA.atrasado) return false;
+      return true;
+    });
+  }, [data, q, statusFiltro, periodo, forma, origem]);
+
+  const totais = useMemo(() => {
+    const total = filtered.reduce((s, p) => s + p.valor, 0);
+    const recebido = filtered
+      .filter((p) => p.status === STATUS_PARCELA.recebido)
+      .reduce((s, p) => s + (p.valorRecebido ?? p.valor), 0);
+    const atrasado = filtered
+      .filter((p) => p.status === STATUS_PARCELA.atrasado)
+      .reduce((s, p) => s + p.valor, 0);
+    return { total, recebido, atrasado };
+  }, [filtered]);
+
+  const abrir = (p: Parcela) => {
+    setSelected(p);
+    setDrawerOpen(true);
+  };
+
+  return (
+    <div className="space-y-4">
+      {/* Filtros */}
+      <div className="rounded-3xl border border-rose/10 bg-white/70 p-4 shadow-card backdrop-blur-xl dark:border-white/8 dark:bg-white/4">
+        <div className="flex flex-wrap items-center gap-2">
+          <div className="relative min-w-[220px] flex-1">
+            <Search className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-clay/45 dark:text-white/40" />
+            <input
+              placeholder="Buscar por cliente, CPF, contrato ou parcela"
+              value={q}
+              onChange={(e) => setQ(e.target.value)}
+              className={inputClass + " pl-9"}
+              data-testid="contas-receber-search"
+            />
+          </div>
+          <select
+            value={statusFiltro}
+            onChange={(e) => setStatusFiltro(e.target.value)}
+            className={selectClass + " w-[170px]"}
+            data-testid="filter-status"
+          >
+            <option value="todos">Todos os status</option>
+            {Object.entries(STATUS_LABEL).map(([k, v]) => (
+              <option key={k} value={k}>{v}</option>
+            ))}
+          </select>
+          <select
+            value={periodo}
+            onChange={(e) => setPeriodo(e.target.value)}
+            className={selectClass + " w-[170px]"}
+          >
+            {Object.entries(PERIODOS).map(([k, v]) => (
+              <option key={k} value={k}>{v}</option>
+            ))}
+          </select>
+          <select
+            value={forma}
+            onChange={(e) => setForma(e.target.value)}
+            className={selectClass + " w-[180px]"}
+          >
+            <option value="todos">Todas as formas</option>
+            {Object.entries(FORMA_LABEL).map(([k, v]) => (
+              <option key={k} value={k}>{v}</option>
+            ))}
+          </select>
+          <select
+            value={origem}
+            onChange={(e) => setOrigem(e.target.value)}
+            className={selectClass + " w-[160px]"}
+          >
+            <option value="todos">Todas as origens</option>
+            {Object.entries(ORIGEM_LABEL).map(([k, v]) => (
+              <option key={k} value={k}>{v}</option>
+            ))}
+          </select>
+          <button
+            className="inline-flex items-center gap-2 rounded-xl border border-rose/15 bg-white/70 px-3 py-2 text-xs font-semibold text-burgundy hover:bg-blush dark:border-white/10 dark:bg-white/5 dark:text-[#f0d9d4]"
+            data-testid="btn-exportar"
+          >
+            <Download className="h-3.5 w-3.5" /> Exportar
+          </button>
+        </div>
+
+        <div className="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-[11px] text-clay/70 dark:text-white/55">
+          <span>
+            <span className="font-semibold tabular-nums text-burgundy dark:text-[#f0d9d4]">{filtered.length}</span> parcelas exibidas
+          </span>
+          <span>
+            Total: <span className="font-semibold tabular-nums text-burgundy dark:text-[#f0d9d4]">{formatCurrency(totais.total)}</span>
+          </span>
+          <span className="text-success">
+            Recebido: <span className="font-semibold tabular-nums">{formatCurrency(totais.recebido)}</span>
+          </span>
+          <span className="text-alert">
+            Em atraso: <span className="font-semibold tabular-nums">{formatCurrency(totais.atrasado)}</span>
+          </span>
+        </div>
+      </div>
+
+      {/* Tabela */}
+      <div className="overflow-hidden rounded-3xl border border-rose/10 bg-white/80 shadow-card backdrop-blur-xl dark:border-white/8 dark:bg-white/4">
+        <div className="overflow-x-auto">
+          <table className="w-full min-w-[1080px] border-collapse text-left">
+            <thead className="bg-blush/40 text-[10px] font-semibold uppercase tracking-[0.16em] text-burgundy/60 dark:bg-white/[0.05] dark:text-white/50">
+              <tr>
+                <Th>Cliente</Th>
+                <Th>Descrição</Th>
+                <Th className="text-center">Parcela</Th>
+                <Th className="text-right">Valor</Th>
+                <Th>Vencimento</Th>
+                <Th>Status</Th>
+                <Th>Forma</Th>
+                <Th>Origem</Th>
+                <Th>Recebido em</Th>
+                <Th />
+              </tr>
+            </thead>
+            <tbody className="divide-y divide-rose/8 text-sm text-clay dark:divide-white/6 dark:text-white/85">
+              {loading && (
+                <tr>
+                  <td colSpan={10} className="py-8 text-center text-clay/55 dark:text-white/45">Carregando…</td>
+                </tr>
+              )}
+              {!loading && filtered.length === 0 && (
+                <tr>
+                  <td colSpan={10} className="py-10 text-center text-clay/55 dark:text-white/45">
+                    <Filter className="mr-1 inline h-4 w-4" /> Nenhuma parcela com os filtros atuais.
+                  </td>
+                </tr>
+              )}
+              {filtered.map((p) => (
+                <tr
+                  key={p.id}
+                  onClick={() => abrir(p)}
+                  className="cursor-pointer transition-colors hover:bg-blush/25 dark:hover:bg-white/[0.03]"
+                  data-testid={`row-parcela-${p.id}`}
+                >
+                  <Td>
+                    <div className="font-semibold text-burgundy dark:text-[#f0d9d4]">{p.clienteNome}</div>
+                    <div className="text-[10px] uppercase tracking-[0.14em] text-clay/55 dark:text-white/45">
+                      {formatCPF(p.clienteCpf)}
+                    </div>
+                  </Td>
+                  <Td>
+                    <div className="line-clamp-1 max-w-[280px]">{p.descricao}</div>
+                    <div className="text-[10px] uppercase tracking-[0.14em] text-clay/55 dark:text-white/45">
+                      {p.clienteContrato}
+                    </div>
+                  </Td>
+                  <Td className="text-center tabular-nums">{p.numero}/{p.totalParcelas}</Td>
+                  <Td className="text-right font-semibold tabular-nums">{formatCurrency(p.valor)}</Td>
+                  <Td className="tabular-nums">{formatDateBR(p.vencimento)}</Td>
+                  <Td><StatusBadge status={p.status as StatusParcela} /></Td>
+                  <Td><FormaPagamentoBadge forma={p.formaPagamento} /></Td>
+                  <Td><OrigemBadge origem={p.origem} /></Td>
+                  <Td className="tabular-nums">{p.recebidoEm ? formatDateBR(p.recebidoEm) : "—"}</Td>
+                  <Td onClick={(e) => e.stopPropagation()} className="w-[40px]">
+                    <button
+                      className="rounded-lg p-1.5 text-clay/50 hover:bg-blush hover:text-burgundy dark:text-white/45 dark:hover:bg-white/8"
+                      onClick={() => abrir(p)}
+                      aria-label="Ações"
+                    >
+                      <MoreHorizontal className="h-4 w-4" />
+                    </button>
+                  </Td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      </div>
+
+      <ParcelaDetailDrawer parcela={selected} open={drawerOpen} onOpenChange={setDrawerOpen} />
+    </div>
+  );
+}
+
+function Th({ children, className }: { children?: React.ReactNode; className?: string }) {
+  return <th className={`px-3 py-3 ${className ?? ""}`}>{children}</th>;
+}
+function Td({
+  children,
+  className,
+  onClick,
+}: {
+  children?: React.ReactNode;
+  className?: string;
+  onClick?: (e: React.MouseEvent<HTMLTableCellElement>) => void;
+}) {
+  return (
+    <td className={`px-3 py-3 ${className ?? ""}`} onClick={onClick}>
+      {children}
+    </td>
+  );
+}
diff --git a/src/app/admin/(painel)/financeiro/historico/page.tsx b/src/app/admin/(painel)/financeiro/historico/page.tsx
