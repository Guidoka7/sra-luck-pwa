+              </thead>
+              <tbody className="divide-y divide-rose/8 text-sm text-clay dark:divide-white/6 dark:text-white/85">
+                {comprovantes.length === 0 && (
+                  <tr>
+                    <td colSpan={5} className="py-8 text-center text-clay/55 dark:text-white/45">
