+    .filter((p) => p.recebidoEm)
+    .sort((a, b) => new Date(b.recebidoEm!).getTime() - new Date(a.recebidoEm!).getTime());
+  const comprovantes = parcelas.flatMap((p) =>
+    (p.comprovantes || []).map((c) => ({
+      ...c,
+      parcelaNumero: `${p.numero}/${p.totalParcelas}`,
