@@ -0,0 +1,258 @@
+"use client";
+
+import { useState, ReactNode } from "react";
+import {
+  ArrowDownToLine,
+  CircleDollarSign,
+  FileText,
+  Paperclip,
+  RefreshCw,
+  XCircle,
+  User,
+  Phone,
+  Receipt,
+  History,
+  Percent,
+  LucideIcon,
+} from "lucide-react";
+import { Button } from "@/components/ui/Button";
+import { cn } from "@/lib/utils";
+import { Drawer } from "./Modal";
+import { StatusBadge, FormaPagamentoBadge, OrigemBadge } from "./badges";
+import { formatCurrency, formatCPF, formatDateBR, formatDateTimeBR, formatPhoneBR } from "../utils";
+import {
+  RegistrarRecebimentoDialog,
+  NegociarDialog,
+  CancelarDialog,
+  AnexarComprovanteDialog,
+} from "./dialogs";
+import { useComissoesByParcela } from "../hooks";
+import { STATUS_PARCELA, Parcela } from "../types";
+
+const TABS = [
+  { id: "detalhes", label: "Detalhes", Icon: FileText },
+  { id: "recebimento", label: "Recebimento", Icon: CircleDollarSign },
+  { id: "comissoes", label: "Comissões", Icon: Percent },
+  { id: "comprovantes", label: "Comprovantes", Icon: Paperclip },
+] as const;
+
+type TabId = (typeof TABS)[number]["id"];
+
+export default function ParcelaDetailDrawer({
+  parcela,
+  open,
+  onOpenChange,
+}: {
+  parcela: Parcela | null;
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+}) {
+  const [tab, setTab] = useState<TabId>("detalhes");
+  const [dlgReceb, setDlgReceb] = useState(false);
+  const [dlgNeg, setDlgNeg] = useState(false);
+  const [dlgCancel, setDlgCancel] = useState(false);
+  const [dlgComp, setDlgComp] = useState(false);
+
+  const { data: comissoes } = useComissoesByParcela(parcela?.id);
+  const podeReceber =
+    !!parcela &&
+    parcela.status !== STATUS_PARCELA.recebido &&
+    parcela.status !== STATUS_PARCELA.cancelado;
+
+  return (
+    <>
+      <Drawer open={open} onClose={() => onOpenChange(false)}>
+        {parcela && (
+          <div data-testid="parcela-drawer">
+            <div className="border-b border-rose/10 bg-blush/25 px-6 pt-5 pb-4 dark:border-white/8 dark:bg-white/[0.03]">
+              <p className="text-[10px] font-semibold uppercase tracking-[0.18em] text-clay/55 dark:text-white/45">
+                Parcela {parcela.numero}/{parcela.totalParcelas} · {parcela.clienteContrato}
+              </p>
+              <h2 className="mt-1 text-2xl font-semibold tabular-nums tracking-[-0.02em] text-burgundy dark:text-[#f0d9d4]">
+                {formatCurrency(parcela.valor)}
+              </h2>
+              <div className="mt-3 flex flex-wrap items-center gap-2">
+                <StatusBadge status={parcela.status} />
+                <OrigemBadge origem={parcela.origem} />
+              </div>
+              <div className="mt-4 flex flex-wrap gap-2">
+                <Button
+                  size="sm"
+                  onClick={() => setDlgReceb(true)}
+                  disabled={!podeReceber}
+                  data-testid="btn-registrar-recebimento"
+                >
+                  <ArrowDownToLine className="h-3.5 w-3.5" /> Registrar recebimento
+                </Button>
+                <Button size="sm" variant="secondary" onClick={() => setDlgNeg(true)}>
+                  <RefreshCw className="h-3.5 w-3.5" /> Negociar
+                </Button>
+                <Button size="sm" variant="secondary" onClick={() => setDlgComp(true)}>
+                  <Paperclip className="h-3.5 w-3.5" /> Anexar
+                </Button>
+                <Button size="sm" variant="danger" onClick={() => setDlgCancel(true)}>
+                  <XCircle className="h-3.5 w-3.5" /> Cancelar
+                </Button>
+              </div>
+            </div>
+
+            <div className="border-b border-rose/8 px-6 dark:border-white/6">
+              <div className="flex gap-1 overflow-x-auto">
+                {TABS.map((t) => (
+                  <button
+                    key={t.id}
+                    onClick={() => setTab(t.id)}
+                    className={cn(
+                      "inline-flex items-center gap-1.5 border-b-2 px-3 py-3 text-xs font-medium whitespace-nowrap transition-colors",
+                      tab === t.id
+                        ? "border-burgundy text-burgundy dark:border-[#e8bcbc] dark:text-[#f0d9d4]"
+                        : "border-transparent text-clay/60 hover:text-burgundy dark:text-white/50",
+                    )}
+                  >
+                    <t.Icon className="h-3.5 w-3.5" />
+                    {t.label}
+                  </button>
+                ))}
+              </div>
+            </div>
+
+            <div className="space-y-4 p-6">
+              {tab === "detalhes" && (
+                <>
+                  <SectionCard title="Cliente" icon={User}>
+                    <Info label="Nome" value={parcela.clienteNome} />
+                    <Info label="CPF" value={formatCPF(parcela.clienteCpf)} />
+                    <Info label="Contrato" value={parcela.clienteContrato} />
+                    <Info
+                      label="Contato"
+                      value={
+                        <span className="inline-flex items-center gap-1">
+                          <Phone className="h-3 w-3" />
+                          {formatPhoneBR(parcela.clienteTelefone)}
+                        </span>
+                      }
+                    />
+                  </SectionCard>
+                  <SectionCard title="Parcela" icon={Receipt}>
+                    <Info label="Descrição" value={parcela.descricao} span={2} />
+                    <Info label="Número" value={`${parcela.numero}/${parcela.totalParcelas}`} />
+                    <Info label="Valor" value={formatCurrency(parcela.valor)} />
+                    <Info label="Vencimento" value={formatDateBR(parcela.vencimento)} />
+                    <Info label="Status" value={<StatusBadge status={parcela.status} />} />
+                  </SectionCard>
+                </>
+              )}
+
+              {tab === "recebimento" && (
+                <SectionCard title="Recebimento" icon={CircleDollarSign}>
+                  <Info label="Forma" value={<FormaPagamentoBadge forma={parcela.formaPagamento} />} />
+                  <Info label="Origem" value={<OrigemBadge origem={parcela.origem} />} />
+                  <Info label="Data" value={parcela.recebidoEm ? formatDateTimeBR(parcela.recebidoEm) : "—"} />
+                  <Info label="Valor recebido" value={parcela.valorRecebido ? formatCurrency(parcela.valorRecebido) : "—"} />
+                  {parcela.observacoes && (
+                    <Info label="Observações" value={parcela.observacoes} span={2} />
+                  )}
+                </SectionCard>
+              )}
+
+              {tab === "comissoes" && (
+                <div className="space-y-2">
+                  {(comissoes ?? []).length === 0 && (
+                    <p className="text-xs text-clay/60 dark:text-white/50">
+                      Nenhuma comissão vinculada a esta parcela.
+                    </p>
+                  )}
+                  {(comissoes ?? []).map((c) => (
+                    <div
+                      key={c.id}
+                      className="flex items-center justify-between rounded-2xl border border-rose/10 bg-white/70 p-3 dark:border-white/8 dark:bg-white/4"
+                    >
+                      <div>
+                        <div className="text-sm font-semibold text-burgundy dark:text-[#f0d9d4]">
+                          {c.vendedora}
+                        </div>
+                        <div className="text-[10px] uppercase tracking-[0.14em] text-clay/55 dark:text-white/45">
+                          {c.percentual}% sobre {formatCurrency(parcela.valor)}
+                        </div>
+                      </div>
+                      <div className="text-right">
+                        <div className="text-sm font-semibold tabular-nums text-clay dark:text-white/85">
+                          {formatCurrency(c.valor)}
+                        </div>
+                        <div className="text-[10px] uppercase tracking-[0.12em] text-clay/60 dark:text-white/45">
+                          {c.status.replace(/_/g, " ")}
+                        </div>
+                      </div>
+                    </div>
+                  ))}
+                  <p className="pt-2 text-[10px] text-clay/45 dark:text-white/35">
+                    ⚠️ A lógica real de comissões existente não é alterada nesta etapa.
+                  </p>
+                </div>
+              )}
+
+              {tab === "comprovantes" && (
+                <div className="space-y-2">
+                  {(parcela.comprovantes || []).length === 0 && (
+                    <p className="text-xs text-clay/60 dark:text-white/50">Nenhum comprovante anexado.</p>
+                  )}
+                  {(parcela.comprovantes || []).map((c) => (
+                    <div
+                      key={c.id}
+                      className="flex items-center justify-between rounded-2xl border border-rose/10 bg-white/70 p-3 dark:border-white/8 dark:bg-white/4"
+                    >
+                      <div className="flex items-center gap-3">
+                        <Paperclip className="h-4 w-4 text-burgundy/60 dark:text-[#d9a5a3]" />
+                        <div>
+                          <div className="text-sm font-medium text-clay dark:text-white/85">{c.nome}</div>
+                          <div className="text-[10px] uppercase tracking-[0.14em] text-clay/55 dark:text-white/45">
+                            {formatDateBR(c.data)} · {c.origem} · {c.status.replace(/_/g, " ")}
+                          </div>
+                        </div>
+                      </div>
+                    </div>
+                  ))}
+                </div>
+              )}
+
+              <p className="mt-4 flex items-center gap-2 text-[10px] text-clay/45 dark:text-white/35">
+                <History className="h-3 w-3" />
+                Ao registrar recebimento, histórico e comissões relacionadas são atualizados automaticamente.
+              </p>
+            </div>
+          </div>
+        )}
+      </Drawer>
+
+      <RegistrarRecebimentoDialog parcela={parcela} open={dlgReceb} onOpenChange={setDlgReceb} />
+      <NegociarDialog parcela={parcela} open={dlgNeg} onOpenChange={setDlgNeg} />
+      <CancelarDialog parcela={parcela} open={dlgCancel} onOpenChange={setDlgCancel} />
+      <AnexarComprovanteDialog parcela={parcela} open={dlgComp} onOpenChange={setDlgComp} />
+    </>
+  );
+}
+
+function SectionCard({ title, icon: Icon, children }: { title: string; icon: LucideIcon; children: ReactNode }) {
+  return (
+    <div className="overflow-hidden rounded-2xl border border-rose/10 dark:border-white/8">
+      <div className="flex items-center gap-2 border-b border-rose/8 bg-blush/25 px-4 py-2 dark:border-white/6 dark:bg-white/[0.03]">
+        <Icon className="h-3.5 w-3.5 text-burgundy/60 dark:text-[#d9a5a3]" />
+        <span className="text-[10px] font-semibold uppercase tracking-[0.18em] text-clay/60 dark:text-white/50">
+          {title}
+        </span>
+      </div>
+      <div className="grid grid-cols-2 gap-x-4 gap-y-3 bg-white/70 p-4 dark:bg-white/2">{children}</div>
+    </div>
+  );
+}
+
+function Info({ label, value, span = 1 }: { label: string; value: ReactNode; span?: 1 | 2 }) {
+  return (
+    <div className={span === 2 ? "col-span-2" : "col-span-1"}>
+      <div className="mb-0.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-clay/55 dark:text-white/45">
+        {label}
+      </div>
+      <div className="text-sm font-medium text-clay dark:text-white/85">{value}</div>
+    </div>
+  );
+}
