+
+      {tab === "historico" && (
+        <div className="rounded-3xl border border-rose/10 bg-white/70 p-4 text-sm text-clay/70 shadow-card dark:border-white/8 dark:bg-white/4 dark:text-white/55">
+          Histórico consolidado do cliente será exibido aqui quando o backend real do Sra. Luck fornecer eventos.
+          O Histórico geral do módulo já registra todas as ações executadas.
+        </div>
+      )}
+
+      {tab === "comprovantes" && (
+        <div className="overflow-hidden rounded-3xl border border-rose/10 bg-white/80 shadow-card backdrop-blur-xl dark:border-white/8 dark:bg-white/4">
+          <div className="overflow-x-auto">
+            <table className="w-full border-collapse text-left">
+              <thead className="bg-blush/40 text-[10px] font-semibold uppercase tracking-[0.16em] text-burgundy/60 dark:bg-white/[0.05] dark:text-white/50">
+                <tr>
+                  <th className="px-3 py-3">Arquivo</th>
+                  <th className="px-3 py-3">Parcela</th>
+                  <th className="px-3 py-3">Data</th>
