+                )}
+                {comprovantes.map((c) => (
+                  <tr key={c.id}>
+                    <td className="px-3 py-3">
+                      <span className="inline-flex items-center gap-2">
+                        <FileText className="h-3.5 w-3.5 text-clay/50 dark:text-white/40" />
+                        {c.nome}
+                      </span>
+                    </td>
+                    <td className="px-3 py-3 tabular-nums">{c.parcelaNumero}</td>
+                    <td className="px-3 py-3 tabular-nums">{formatDateBR(c.data)}</td>
+                    <td className="px-3 py-3">
+                      <OrigemBadge origem={c.origem as any} />
+                    </td>
+                    <td className="px-3 py-3 text-xs text-clay/70 dark:text-white/55">
+                      {c.status.replace(/_/g, " ")}
+                    </td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+        </div>
+      )}
+
+      {tab === "pagamentos" && (
+        <div className="overflow-hidden rounded-3xl border border-rose/10 bg-white/80 shadow-card backdrop-blur-xl dark:border-white/8 dark:bg-white/4">
+          <div className="overflow-x-auto">
+            <table className="w-full border-collapse text-left">
+              <thead className="bg-blush/40 text-[10px] font-semibold uppercase tracking-[0.16em] text-burgundy/60 dark:bg-white/[0.05] dark:text-white/50">
