+"use client";
+
+import { cn } from "@/lib/utils";
+import {
+  CheckCircle2,
+  AlertTriangle,
+  Clock,
+  RefreshCw,
+  XCircle,
+  Landmark,
+  Wallet,
+  CreditCard,
+  Receipt,
+  Banknote,
+  Building2,
+  ShieldCheck,
+  Hourglass,
+  LucideIcon,
+} from "lucide-react";
+import {
+  StatusParcela,
+  STATUS_PARCELA,
+  STATUS_LABEL,
+  FormaPagamento,
+  FORMA_LABEL,
+  Origem,
+  ORIGEM_LABEL,
+  IntegracaoStatus,
+  INTEGRACAO_STATUS_LABEL,
+} from "../types";
+
+const STATUS_STYLE: Record<StatusParcela, { className: string; Icon: LucideIcon }> = {
+  [STATUS_PARCELA.pendente]: {
+    className:
+      "bg-gold/12 text-clay border-gold/30 dark:bg-gold/20 dark:text-[#e8dcda] dark:border-gold/30",
+    Icon: Clock,
+  },
+  [STATUS_PARCELA.recebido]: {
+    className:
+      "bg-success/12 text-success border-success/25 dark:bg-success/22 dark:text-[#e6f2ea] dark:border-success/40",
+    Icon: CheckCircle2,
+  },
+  [STATUS_PARCELA.atrasado]: {
+    className:
+      "bg-alert/10 text-alert border-alert/25 dark:bg-alert/22 dark:text-[#ffe4e4] dark:border-alert/40",
+    Icon: AlertTriangle,
+  },
+  [STATUS_PARCELA.aguardando]: {
+    className:
+      "bg-blush text-burgundy border-rose/25 dark:bg-white/8 dark:text-[#f0d9d4] dark:border-white/12",
+    Icon: Hourglass,
+  },
+  [STATUS_PARCELA.negociado]: {
+    className:
+      "bg-burgundy/8 text-burgundy border-burgundy/20 dark:bg-white/6 dark:text-[#e8bcbc] dark:border-white/12",
+    Icon: RefreshCw,
+  },
+  [STATUS_PARCELA.cancelado]: {
+    className:
+      "bg-clay/10 text-clay/70 border-clay/15 dark:bg-white/4 dark:text-white/50 dark:border-white/8",
+    Icon: XCircle,
+  },
+};
+
+export function StatusBadge({ status, testId }: { status: StatusParcela; testId?: string }) {
+  const s = STATUS_STYLE[status];
+  const Icon = s.Icon;
+  return (
+    <span
+      className={cn(
+        "inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.1em]",
+        s.className,
+      )}
+      data-testid={testId || `status-badge-${status}`}
+    >
+      <Icon className="h-3 w-3" />
+      {STATUS_LABEL[status]}
+    </span>
+  );
+}
+
+const FORMA_ICON: Record<FormaPagamento, LucideIcon> = {
+  boleto: Receipt,
+  pix: Banknote,
+  cartao_credito: CreditCard,
+  comprovante_manual: ShieldCheck,
+  dinheiro: Wallet,
+};
+
+export function FormaPagamentoBadge({ forma }: { forma: FormaPagamento }) {
+  const Icon = FORMA_ICON[forma] ?? Wallet;
+  return (
+    <span className="inline-flex items-center gap-1.5 text-xs text-clay dark:text-[#d5c8c6]">
+      <Icon className="h-3.5 w-3.5 text-burgundy/60 dark:text-[#d9a5a3]" />
+      {FORMA_LABEL[forma] ?? "—"}
+    </span>
+  );
+}
+
+const ORIGEM_STYLE: Record<Origem, { className: string; Icon: LucideIcon }> = {
+  conta_azul: { className: "border-blue-400/40 bg-blue-500/10 text-blue-600 dark:bg-blue-500/20 dark:text-blue-200", Icon: Building2 },
+  mercado_pago: { className: "border-gold/40 bg-gold/15 text-clay dark:bg-gold/22 dark:text-[#f5dcbf]", Icon: Wallet },
+  banco: { className: "border-emerald-400/30 bg-emerald-500/10 text-emerald-700 dark:bg-emerald-500/18 dark:text-emerald-200", Icon: Landmark },
+  manual: { className: "border-clay/20 bg-clay/8 text-clay dark:bg-white/6 dark:text-white/68", Icon: ShieldCheck },
+};
+
+export function OrigemBadge({ origem }: { origem: Origem }) {
+  const s = ORIGEM_STYLE[origem] ?? ORIGEM_STYLE.manual;
+  const Icon = s.Icon;
+  return (
+    <span
+      className={cn(
+        "inline-flex items-center gap-1 rounded-md border px-1.5 py-0.5 text-[10px] font-medium",
+        s.className,
+      )}
+    >
+      <Icon className="h-3 w-3" />
+      {ORIGEM_LABEL[origem] ?? "—"}
+    </span>
+  );
+}
+
+const INT_STYLE: Record<IntegracaoStatus, string> = {
+  em_preparacao: "bg-gold/15 text-clay border-gold/35 dark:bg-gold/22 dark:text-[#f5dcbf]",
+  planejado: "bg-clay/8 text-clay border-clay/20 dark:bg-white/6 dark:text-white/60",
+  nao_conectado: "bg-alert/10 text-alert border-alert/25",
+  em_desenvolvimento: "bg-burgundy/8 text-burgundy border-burgundy/20",
+};
+
+export function IntegracaoStatusBadge({ status }: { status: IntegracaoStatus }) {
+  return (
+    <span
+      className={cn(
+        "inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.1em]",
+        INT_STYLE[status],
+      )}
+    >
+      {INTEGRACAO_STATUS_LABEL[status]}
+    </span>
+  );
+}
