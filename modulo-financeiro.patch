@@ -0,0 +1,66 @@
+// ApiAdapter — STUB preparado para receber, futuramente:
+//   • Endpoints REST do Sra. Luck  (/api/admin/financeiro/**)
+//   • Endpoints do Conta Azul       (via backend proxy)
+//   • Endpoints do Mercado Pago     (via backend proxy)
+//   • Webhooks bancários            (recebidos pelo backend)
+//
+// Implementação real deve preservar a MESMA interface do MockAdapter
+// (FinanceiroDataSource) para troca sem alterar componentes/hooks/serviços.
+
+import type { FinanceiroDataSource, RegistrarRecebimentoInput } from "./MockAdapter";
+import type { Parcela } from "../types";
+
+async function req<T>(url: string, init?: RequestInit): Promise<T> {
+  const res = await fetch(url, {
+    ...init,
+    headers: {
+      "Content-Type": "application/json",
+      ...(init?.headers ?? {}),
+    },
+    credentials: "same-origin",
+  });
+  if (!res.ok) throw new Error(`Erro ${res.status} em ${url}`);
+  return (await res.json()) as T;
+}
+
+const ApiAdapter: FinanceiroDataSource = {
+  subscribe: () => () => {},
+  listParcelas: () => req("/api/admin/financeiro/parcelas"),
+  getParcela: (id) => req(`/api/admin/financeiro/parcelas/${id}`),
+  registrarRecebimento: (id, payload: RegistrarRecebimentoInput) =>
+    req(`/api/admin/financeiro/parcelas/${id}/recebimento`, {
+      method: "POST",
+      body: JSON.stringify(payload),
+    }),
+  atualizarParcela: (id, patch: Partial<Parcela>) =>
+    req(`/api/admin/financeiro/parcelas/${id}`, {
+      method: "PATCH",
+      body: JSON.stringify(patch),
+    }),
+  negociarParcela: (id, payload) =>
+    req(`/api/admin/financeiro/parcelas/${id}/negociar`, {
+      method: "POST",
+      body: JSON.stringify(payload),
+    }),
+  cancelarParcela: (id, motivo) =>
+    req(`/api/admin/financeiro/parcelas/${id}/cancelar`, {
+      method: "POST",
+      body: JSON.stringify({ motivo }),
+    }),
+  anexarComprovante: (id, payload) =>
+    req(`/api/admin/financeiro/parcelas/${id}/comprovantes`, {
+      method: "POST",
+      body: JSON.stringify(payload),
+    }),
+  listClientes: () => req("/api/admin/financeiro/clientes"),
+  getCliente: (id) => req(`/api/admin/financeiro/clientes/${id}`),
+  getParcelasByCliente: (id) => req(`/api/admin/financeiro/clientes/${id}/parcelas`),
+  listRecebimentos: () => req("/api/admin/financeiro/recebimentos"),
+  listComissoes: () => req("/api/admin/financeiro/comissoes"),
+  getComissoesByParcela: (id) => req(`/api/admin/financeiro/parcelas/${id}/comissoes`),
+  listIntegracoes: () => req("/api/admin/financeiro/integracoes"),
+  getSincronizacao: () => req("/api/admin/financeiro/sincronizacao"),
+  listHistorico: () => req("/api/admin/financeiro/historico"),
+};
+
+export default ApiAdapter;
diff --git a/src/features/financeiro/adapters/MockAdapter.ts b/src/features/financeiro/adapters/MockAdapter.ts
new file mode 100644
index 0000000..80a0caa
--- /dev/null
+++ b/src/features/financeiro/adapters/MockAdapter.ts
@@ -0,0 +1,248 @@
+// Adapter Mock — implementa a interface do FinanceiroDataSource
+// usando dados locais. Deve ser trocável por ApiAdapter sem alterar componentes.
+
+import { MOCK } from "../data/mockData";
+import {
+  Cliente,
+  Comissao,
+  EventoHistorico,
+  Integracao,
+  Parcela,
+  Recebimento,
+  SincronizacaoStatus,
+  STATUS_PARCELA,
+  HISTORICO_TIPOS,
+  FormaPagamento,
+  Origem,
+} from "../types";
+import { isOverdue } from "../utils";
+
+const state = {
+  parcelas: MOCK.parcelas.map((p) => ({ ...p })),
+  clientes: MOCK.clientes.map((c) => ({ ...c })),
+  comissoes: MOCK.comissoes.map((c) => ({ ...c })),
+  integracoes: MOCK.integracoes.map((i) => ({ ...i })),
+  historico: MOCK.historico.map((h) => ({ ...h })),
+  sincronizacao: { ...MOCK.sincronizacao },
+};
+
+const withDynamicStatus = (p: Parcela): Parcela => {
+  if (p.status === STATUS_PARCELA.pendente && isOverdue(p)) {
+    return { ...p, status: STATUS_PARCELA.atrasado };
+  }
+  return p;
+};
+
+type Listener = () => void;
+const listeners = new Set<Listener>();
+const notify = (): void => listeners.forEach((l) => l());
+const delay = (ms = 120) => new Promise<void>((r) => setTimeout(r, ms));
+
+const pushHistorico = (entry: Omit<EventoHistorico, "id" | "data"> & { data?: string }): void => {
+  state.historico.unshift({
+    id: `hist_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`,
+    data: entry.data ?? new Date().toISOString(),
+    tipo: entry.tipo,
+    descricao: entry.descricao,
+    parcelaId: entry.parcelaId,
+    clienteId: entry.clienteId,
+  });
+};
+
+export interface RegistrarRecebimentoInput {
+  valor?: number;
+  data?: string;
+  formaPagamento?: FormaPagamento;
+  origem?: Origem;
+  observacoes?: string;
+}
+
+export interface FinanceiroDataSource {
+  subscribe(listener: Listener): () => void;
+  listParcelas(): Promise<Parcela[]>;
+  getParcela(id: string): Promise<Parcela | null>;
+  registrarRecebimento(id: string, payload: RegistrarRecebimentoInput): Promise<Parcela>;
+  atualizarParcela(id: string, patch: Partial<Parcela>): Promise<Parcela>;
+  negociarParcela(id: string, payload: { novoVencimento?: string; observacoes?: string }): Promise<Parcela>;
+  cancelarParcela(id: string, motivo?: string): Promise<Parcela>;
+  anexarComprovante(id: string, payload: { nome?: string; origem?: string }): Promise<Parcela>;
+  listClientes(): Promise<Cliente[]>;
+  getCliente(id: string): Promise<Cliente | null>;
+  getParcelasByCliente(clienteId: string): Promise<Parcela[]>;
+  listRecebimentos(): Promise<Recebimento[]>;
+  listComissoes(): Promise<Comissao[]>;
+  getComissoesByParcela(parcelaId: string): Promise<Comissao[]>;
+  listIntegracoes(): Promise<Integracao[]>;
+  getSincronizacao(): Promise<SincronizacaoStatus>;
+  listHistorico(): Promise<EventoHistorico[]>;
+}
+
+const MockAdapter: FinanceiroDataSource = {
+  subscribe(listener) {
+    listeners.add(listener);
+    return () => listeners.delete(listener);
+  },
+  async listParcelas() {
+    await delay();
+    return state.parcelas.map(withDynamicStatus);
+  },
+  async getParcela(id) {
+    await delay(60);
+    const p = state.parcelas.find((x) => x.id === id);
+    return p ? withDynamicStatus(p) : null;
+  },
+  async registrarRecebimento(id, payload) {
+    await delay(180);
+    const idx = state.parcelas.findIndex((p) => p.id === id);
+    if (idx === -1) throw new Error("Parcela não encontrada");
+    const orig = state.parcelas[idx];
+    state.parcelas[idx] = {
+      ...orig,
+      status: STATUS_PARCELA.recebido,
+      valorRecebido: payload.valor ?? orig.valor,
+      recebidoEm: payload.data ?? new Date().toISOString(),
+      formaPagamento: payload.formaPagamento ?? orig.formaPagamento,
+      origem: payload.origem ?? orig.origem,
+      observacoes: payload.observacoes ?? orig.observacoes,
+    };
+    state.comissoes = state.comissoes.map((c) =>
+      c.parcelaId === id ? { ...c, status: "liberada", parcelaStatus: STATUS_PARCELA.recebido } : c,
+    );
+    pushHistorico({
+      tipo: HISTORICO_TIPOS.recebimento,
+      descricao: `Recebimento registrado — parcela ${orig.numero}/${orig.totalParcelas} de ${orig.clienteNome}`,
+      parcelaId: id,
+      clienteId: orig.clienteId,
+    });
+    notify();
+    return state.parcelas[idx];
+  },
+  async atualizarParcela(id, patch) {
+    await delay(140);
+    const idx = state.parcelas.findIndex((p) => p.id === id);
+    if (idx === -1) throw new Error("Parcela não encontrada");
+    state.parcelas[idx] = { ...state.parcelas[idx], ...patch };
+    pushHistorico({
+      tipo: HISTORICO_TIPOS.parcela_alterada,
+      descricao: `Parcela ${state.parcelas[idx].numero}/${state.parcelas[idx].totalParcelas} de ${state.parcelas[idx].clienteNome} atualizada`,
+      parcelaId: id,
+      clienteId: state.parcelas[idx].clienteId,
+    });
+    notify();
+    return state.parcelas[idx];
+  },
+  async negociarParcela(id, { novoVencimento, observacoes }) {
+    await delay(150);
+    const idx = state.parcelas.findIndex((p) => p.id === id);
+    if (idx === -1) throw new Error("Parcela não encontrada");
+    state.parcelas[idx] = {
+      ...state.parcelas[idx],
+      vencimento: novoVencimento || state.parcelas[idx].vencimento,
+      status: STATUS_PARCELA.negociado,
+      observacoes: observacoes || state.parcelas[idx].observacoes,
+    };
+    pushHistorico({
+      tipo: HISTORICO_TIPOS.negociacao,
+      descricao: `Negociação registrada — parcela ${state.parcelas[idx].numero}/${state.parcelas[idx].totalParcelas} de ${state.parcelas[idx].clienteNome}`,
+      parcelaId: id,
+      clienteId: state.parcelas[idx].clienteId,
+    });
+    notify();
+    return state.parcelas[idx];
+  },
+  async cancelarParcela(id, motivo) {
+    await delay(120);
+    const idx = state.parcelas.findIndex((p) => p.id === id);
+    if (idx === -1) throw new Error("Parcela não encontrada");
+    state.parcelas[idx] = {
+      ...state.parcelas[idx],
+      status: STATUS_PARCELA.cancelado,
+      observacoes: motivo || state.parcelas[idx].observacoes,
+    };
+    state.comissoes = state.comissoes.map((c) =>
+      c.parcelaId === id ? { ...c, status: "cancelada", parcelaStatus: STATUS_PARCELA.cancelado } : c,
+    );
+    pushHistorico({
+      tipo: HISTORICO_TIPOS.cancelamento,
+      descricao: `Parcela cancelada — ${state.parcelas[idx].clienteNome}${motivo ? " — " + motivo : ""}`,
+      parcelaId: id,
+      clienteId: state.parcelas[idx].clienteId,
+    });
+    notify();
+    return state.parcelas[idx];
+  },
+  async anexarComprovante(id, { nome, origem }) {
+    await delay(130);
+    const idx = state.parcelas.findIndex((p) => p.id === id);
+    if (idx === -1) throw new Error("Parcela não encontrada");
+    const novo = {
+      id: `cmp_${Date.now()}`,
+      nome: nome || "comprovante.pdf",
+      data: new Date().toISOString(),
+      origem: origem || "manual",
+      status: "aguardando_validacao",
+    };
+    state.parcelas[idx] = {
+      ...state.parcelas[idx],
+      comprovantes: [...(state.parcelas[idx].comprovantes || []), novo],
+    };
+    pushHistorico({
+      tipo: HISTORICO_TIPOS.comprovante,
+      descricao: `Comprovante anexado à parcela ${state.parcelas[idx].numero}/${state.parcelas[idx].totalParcelas} de ${state.parcelas[idx].clienteNome}`,
+      parcelaId: id,
+      clienteId: state.parcelas[idx].clienteId,
+    });
+    notify();
+    return state.parcelas[idx];
+  },
+  async listClientes() {
+    await delay();
+    return state.clientes.map((c) => c);
+  },
+  async getCliente(id) {
+    await delay(60);
+    return state.clientes.find((c) => c.id === id) || null;
+  },
+  async getParcelasByCliente(clienteId) {
+    await delay(80);
+    return state.parcelas.filter((p) => p.clienteId === clienteId).map(withDynamicStatus);
+  },
+  async listRecebimentos() {
+    await delay();
+    return state.parcelas
+      .filter((p) => p.status === STATUS_PARCELA.recebido)
+      .map((p) => ({
+        id: `rec_${p.id}`,
+        parcelaId: p.id,
+        clienteId: p.clienteId,
+        clienteNome: p.clienteNome,
+        descricao: p.descricao,
+        valor: p.valorRecebido ?? p.valor,
+        data: p.recebidoEm,
+        formaPagamento: p.formaPagamento,
+        origem: p.origem,
+      }));
+  },
+  async listComissoes() {
+    await delay();
+    return state.comissoes.map((c) => c);
+  },
+  async getComissoesByParcela(parcelaId) {
+    await delay(60);
+    return state.comissoes.filter((c) => c.parcelaId === parcelaId);
+  },
+  async listIntegracoes() {
+    await delay(80);
+    return state.integracoes.map((i) => i);
+  },
+  async getSincronizacao() {
+    await delay(60);
+    return { ...state.sincronizacao };
+  },
+  async listHistorico() {
+    await delay(80);
+    return state.historico.map((h) => h);
+  },
+};
+
+export default MockAdapter;
