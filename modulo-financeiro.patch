+"use client";
+
+import { AlertCircle } from "lucide-react";
+import { useComissoes } from "@/features/financeiro/hooks";
+import { formatCurrency } from "@/features/financeiro/utils";
+import { cn } from "@/lib/utils";
+
+const STATUS = {
+  liberada: { className: "bg-success/12 text-success border-success/25", label: "Liberada" },
+  paga: { className: "bg-burgundy/8 text-burgundy border-burgundy/20", label: "Paga" },
+  aguardando_recebimento: { className: "bg-gold/15 text-clay border-gold/30", label: "Aguardando" },
+  cancelada: { className: "bg-clay/10 text-clay/70 border-clay/20", label: "Cancelada" },
+} as const;
+
+export default function ComissoesPage() {
+  const { data, loading } = useComissoes();
+  const list = data || [];
+  const total = list.reduce((s, c) => s + c.valor, 0);
+  const liberadas = list
+    .filter((c) => c.status === "liberada" || c.status === "paga")
+    .reduce((s, c) => s + c.valor, 0);
+
+  return (
+    <div className="space-y-4">
+      <div className="flex items-start gap-3 rounded-3xl border border-gold/25 bg-gold/12 p-4 text-sm text-clay dark:border-gold/30 dark:bg-gold/15 dark:text-[#f5dcbf]">
+        <AlertCircle className="mt-0.5 h-4 w-4 shrink-0" />
+        <span>
+          A lógica real de cálculo e pagamento das comissões do Sra. Luck permanece inalterada nesta etapa.
+          Esta tela apenas exibe o relacionamento entre parcelas e comissões.
+        </span>
+      </div>
+
+      <div className="grid grid-cols-2 gap-4 md:grid-cols-4">
+        <Stat label="Total geral" value={formatCurrency(total)} />
+        <Stat label="Liberadas / Pagas" value={formatCurrency(liberadas)} accent="success" />
+        <Stat label="Quantidade" value={String(list.length)} />
+        <Stat
+          label="Aguardando"
+          value={String(list.filter((c) => c.status === "aguardando_recebimento").length)}
+          accent="gold"
+        />
+      </div>
+
+      <div className="overflow-hidden rounded-3xl border border-rose/10 bg-white/80 shadow-card backdrop-blur-xl dark:border-white/8 dark:bg-white/4">
+        <div className="overflow-x-auto">
+          <table className="w-full border-collapse text-left">
+            <thead className="bg-blush/40 text-[10px] font-semibold uppercase tracking-[0.16em] text-burgundy/60 dark:bg-white/[0.05] dark:text-white/50">
+              <tr>
+                <th className="px-3 py-3">Vendedora</th>
+                <th className="px-3 py-3">Cliente</th>
+                <th className="px-3 py-3 text-center">%</th>
+                <th className="px-3 py-3 text-right">Valor</th>
+                <th className="px-3 py-3">Status</th>
+              </tr>
+            </thead>
+            <tbody className="divide-y divide-rose/8 text-sm text-clay dark:divide-white/6 dark:text-white/85">
+              {loading && (
+                <tr><td colSpan={5} className="py-8 text-center text-clay/55 dark:text-white/45">Carregando…</td></tr>
+              )}
+              {list.map((c) => {
+                const s = STATUS[c.status];
+                return (
+                  <tr key={c.id}>
+                    <td className="px-3 py-3 font-semibold text-burgundy dark:text-[#f0d9d4]">{c.vendedora}</td>
+                    <td className="px-3 py-3">{c.clienteNome}</td>
+                    <td className="px-3 py-3 text-center">{c.percentual}%</td>
+                    <td className="px-3 py-3 text-right font-semibold tabular-nums">{formatCurrency(c.valor)}</td>
+                    <td className="px-3 py-3">
+                      <span
+                        className={cn(
+                          "inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.1em]",
+                          s.className,
+                        )}
+                      >
+                        {s.label}
+                      </span>
+                    </td>
+                  </tr>
+                );
+              })}
+            </tbody>
+          </table>
+        </div>
+      </div>
+    </div>
+  );
+}
+
+function Stat({
+  label,
+  value,
+  accent,
+}: {
+  label: string;
+  value: string;
+  accent?: "success" | "gold";
+}) {
+  const color = accent === "success" ? "text-success" : accent === "gold" ? "text-clay" : "text-burgundy dark:text-[#f0d9d4]";
+  return (
+    <div className="rounded-3xl border border-rose/10 bg-white/70 p-4 shadow-card backdrop-blur-xl dark:border-white/8 dark:bg-white/4">
+      <div className="text-[10px] font-semibold uppercase tracking-[0.14em] text-clay/55 dark:text-white/45">{label}</div>
+      <div className={`mt-1 text-xl font-semibold tabular-nums ${color}`}>{value}</div>
+    </div>
+  );
+}
diff --git a/src/app/admin/(painel)/financeiro/contas-receber/page.tsx b/src/app/admin/(painel)/financeiro/contas-receber/page.tsx
