+"use client";
+
+import { useMemo, useState } from "react";
+import { Search, ArrowDownToLine } from "lucide-react";
+import { useRecebimentos } from "@/features/financeiro/hooks";
+import { formatCurrency, formatDateBR } from "@/features/financeiro/utils";
+import { FormaPagamentoBadge, OrigemBadge } from "@/features/financeiro/components/badges";
+import { inputClass } from "@/features/financeiro/components/Modal";
+
+export default function RecebimentosPage() {
+  const { data, loading } = useRecebimentos();
+  const [q, setQ] = useState("");
