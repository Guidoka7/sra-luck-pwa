+                </tr>
+              </thead>
+              <tbody className="divide-y divide-rose/8 text-sm text-clay dark:divide-white/6 dark:text-white/85">
+                {parcelas.map((p) => (
+                  <tr
+                    key={p.id}
+                    onClick={() => {
+                      setSelected(p);
+                      setDrawerOpen(true);
+                    }}
+                    className="cursor-pointer transition-colors hover:bg-blush/25 dark:hover:bg-white/[0.03]"
+                  >
+                    <td className="px-3 py-3 text-center tabular-nums">
+                      {p.numero}/{p.totalParcelas}
+                    </td>
+                    <td className="px-3 py-3">{p.descricao}</td>
+                    <td className="px-3 py-3 text-right tabular-nums">{formatCurrency(p.valor)}</td>
+                    <td className="px-3 py-3 tabular-nums">{formatDateBR(p.vencimento)}</td>
+                    <td className="px-3 py-3">
+                      <StatusBadge status={p.status} />
+                    </td>
+                    <td className="px-3 py-3 tabular-nums">
+                      {p.recebidoEm ? formatDateBR(p.recebidoEm) : "—"}
