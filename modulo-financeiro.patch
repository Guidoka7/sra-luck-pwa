+"use client";
+
+import { useVisaoGeral } from "@/features/financeiro/hooks";
+import { formatCurrency, formatDateBR } from "@/features/financeiro/utils";
+import { StatusBadge } from "@/features/financeiro/components/badges";
+import {
+  ArrowDownToLine,
+  AlertTriangle,
+  CalendarClock,
+  CircleDollarSign,
+  Percent,
+  LucideIcon,
+} from "lucide-react";
+
+type Accent = "burgundy" | "success" | "alert" | "gold";
+const ACCENT: Record<Accent, string> = {
+  burgundy: "text-burgundy",
+  success: "text-success",
+  alert: "text-alert",
+  gold: "text-clay",
+};
+
+function Stat({
+  icon: Icon,
+  label,
+  value,
+  hint,
+  accent = "burgundy",
+  testId,
+}: {
+  icon: LucideIcon;
+  label: string;
+  value: string;
+  hint?: string;
+  accent?: Accent;
+  testId?: string;
+}) {
+  return (
+    <div
+      className="rounded-3xl border border-rose/10 bg-white/70 p-5 shadow-card backdrop-blur-xl dark:border-white/8 dark:bg-white/4"
+      data-testid={testId}
+    >
+      <div className="flex items-center justify-between">
+        <span className="text-[10px] font-semibold uppercase tracking-[0.18em] text-clay/55 dark:text-white/45">
+          {label}
+        </span>
+        <Icon className={`h-4 w-4 ${ACCENT[accent]}`} />
+      </div>
+      <div className="mt-2 text-2xl font-semibold tabular-nums tracking-[-0.02em] text-burgundy dark:text-[#f0d9d4]">
+        {value}
+      </div>
+      {hint && <div className="mt-1 text-[11px] text-clay/60 dark:text-white/50">{hint}</div>}
+    </div>
+  );
+}
+
+// Gráfico simples de barras SVG (sem dependências externas).
+function SimpleBarChart({ data }: { data: { mes: string; recebido: number; previsto: number }[] }) {
+  const max = Math.max(1, ...data.flatMap((d) => [d.recebido, d.previsto]));
+  const barW = 22;
+  const gap = 6;
+  const groupW = barW * 2 + gap + 24;
+  const width = data.length * groupW + 40;
+  const height = 220;
+
+  return (
+    <svg width="100%" viewBox={`0 0 ${width} ${height}`} className="overflow-visible">
+      {[0.25, 0.5, 0.75, 1].map((p) => (
+        <line
+          key={p}
+          x1="30"
+          x2={width}
+          y1={height - 30 - p * (height - 60)}
+          y2={height - 30 - p * (height - 60)}
+          stroke="currentColor"
+          strokeDasharray="4 4"
+          className="text-clay/12 dark:text-white/10"
+        />
+      ))}
+      {data.map((d, i) => {
+        const previstoH = (d.previsto / max) * (height - 60);
+        const recebidoH = (d.recebido / max) * (height - 60);
+        const x = 30 + i * groupW;
+        return (
+          <g key={i}>
+            <rect
+              x={x}
+              y={height - 30 - previstoH}
+              width={barW}
+              height={previstoH}
+              rx="4"
+              className="fill-rose/25 dark:fill-white/12"
+            />
+            <rect
+              x={x + barW + gap}
+              y={height - 30 - recebidoH}
+              width={barW}
+              height={recebidoH}
+              rx="4"
+              className="fill-burgundy dark:fill-[#c88090]"
+            />
+            <text
+              x={x + barW + gap / 2}
+              y={height - 12}
+              textAnchor="middle"
+              className="fill-clay/60 text-[10px] dark:fill-white/50"
+            >
+              {d.mes}
+            </text>
+          </g>
+        );
+      })}
+    </svg>
+  );
+}
+
+export default function VisaoGeralPage() {
+  const { data, loading } = useVisaoGeral();
+
+  if (loading || !data) {
+    return <div className="text-sm text-clay/60 dark:text-white/50">Carregando visão geral…</div>;
+  }
+
+  return (
+    <div className="space-y-5">
+      <div className="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
+        <Stat
+          icon={CircleDollarSign}
+          label="A receber"
+          value={formatCurrency(data.totalReceber)}
+          hint={`${data.qtdParcelas} parcelas no total`}
+          testId="stat-a-receber"
+        />
+        <Stat
+          icon={ArrowDownToLine}
+          label="Recebido no mês"
+          value={formatCurrency(data.totalRecebidoMes)}
+          hint="Recebimentos deste mês"
+          accent="success"
+          testId="stat-recebido-mes"
+        />
+        <Stat
+          icon={AlertTriangle}
+          label="Em atraso"
+          value={formatCurrency(data.totalAtrasado)}
+          hint={`${data.qtdAtrasadas} parcelas atrasadas`}
+          accent="alert"
+          testId="stat-atrasado"
+        />
+        <Stat
+          icon={Percent}
+          label="Comissões liberadas"
+          value={formatCurrency(data.comissoesLiberadas)}
+          hint="Vinculadas a parcelas recebidas"
+          accent="gold"
+          testId="stat-comissoes"
+        />
+      </div>
+
+      <div className="grid grid-cols-1 gap-4 lg:grid-cols-3">
+        <div className="rounded-3xl border border-rose/10 bg-white/70 p-5 shadow-card backdrop-blur-xl dark:border-white/8 dark:bg-white/4 lg:col-span-2">
+          <div className="mb-3 flex items-center justify-between">
+            <div>
+              <h3 className="text-sm font-semibold text-burgundy dark:text-[#f0d9d4]">
+                Recebido vs previsto
+              </h3>
+              <p className="text-[11px] text-clay/60 dark:text-white/50">Últimos 6 meses</p>
+            </div>
+            <div className="flex gap-3 text-[10px] text-clay/60 dark:text-white/50">
+              <span className="inline-flex items-center gap-1">
+                <span className="h-2 w-2 rounded-sm bg-rose/25 dark:bg-white/20" /> Previsto
+              </span>
+              <span className="inline-flex items-center gap-1">
+                <span className="h-2 w-2 rounded-sm bg-burgundy dark:bg-[#c88090]" /> Recebido
+              </span>
+            </div>
+          </div>
+          <SimpleBarChart data={data.serie} />
+        </div>
+
+        <div className="rounded-3xl border border-rose/10 bg-white/70 p-5 shadow-card backdrop-blur-xl dark:border-white/8 dark:bg-white/4">
+          <div className="mb-3 flex items-center justify-between">
+            <h3 className="text-sm font-semibold text-burgundy dark:text-[#f0d9d4]">
+              Próximos vencimentos
+            </h3>
+            <CalendarClock className="h-4 w-4 text-clay/50 dark:text-white/40" />
+          </div>
+          <div>
+            {data.proximas.map((p) => (
+              <div
+                key={p.id}
+                className="flex items-center justify-between border-b border-rose/8 py-2 last:border-0 dark:border-white/6"
+              >
+                <div className="min-w-0">
+                  <div className="truncate text-sm font-semibold text-burgundy dark:text-[#f0d9d4]">
+                    {p.clienteNome}
+                  </div>
+                  <div className="text-[10px] uppercase tracking-[0.14em] text-clay/55 dark:text-white/45">
+                    {formatDateBR(p.vencimento)} · {p.numero}/{p.totalParcelas}
+                  </div>
+                </div>
+                <div className="ml-3 shrink-0 text-right">
+                  <div className="text-sm font-semibold tabular-nums text-clay dark:text-white/85">
+                    {formatCurrency(p.valor)}
+                  </div>
+                  <div className="mt-0.5">
+                    <StatusBadge status={p.status} />
+                  </div>
+                </div>
+              </div>
+            ))}
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
